rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App update-check ke liye latest version numbers - guest users bhi
    // (sign in kiye bina) padh sakte hain kyunki update prompt sabko dikhna
    // hai. Sirf Firebase Console/Admin SDK se likha ja sakta hai, app se kabhi
    // nahi - is liye write hamesha false.
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Har user ka apna profile doc - koi bhi signed-in user isay READ kar
    // sakta hai (Shared Bills feature ke liye zaroori: kisi doosre user ko
    // uski email se dhoondhna). Sirf khud apna doc likh sakta hai.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Har user ki apni (private) payments - sirf wahi user padh/likh sakta hai.
      match /payments/{paymentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shared/split bills - jitne bhi log us bill mein participant hain
    // (memberUids array), sirf wahi padh/update kar sakte hain. Sirf
    // banane wala (createdBy) hi delete kar sakta hai.
    match /sharedPayments/{sharedId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.memberUids;
      allow update: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }
  }
}
